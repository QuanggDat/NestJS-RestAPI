// Đây là file schema của Prisma,
// tìm hiểu thêm tại: https://pris.ly/d/prisma-schema

// Tạo nhanh một Postgres miễn phí: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  hashedPassword String
  firstName      String?
  lastName       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  //quan hệ
  notes Note[]

  @@map("users") //"users" là tên bảng thật trong Postgres SQL
}

//Một user có thể "viết" nhiều note
model Note {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  url         String
  // các field khác ...
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  //quan hệ
  userId Int //đóng vai trò "khoá ngoại"
  user   User @relation(fields: [userId], references: [id])

  @@map("notes")
}
